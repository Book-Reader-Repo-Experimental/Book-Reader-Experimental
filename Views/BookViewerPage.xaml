<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BookViewer.Views.BookViewerPage"
             BackgroundColor="{AppThemeBinding Light={StaticResource Canvas}, Dark={StaticResource CanvasDark}}">

    <Grid RowDefinitions="Auto,Auto,*,Auto">

        <!-- ================= NAV BAR ================= -->
        <Grid Grid.Row="0"
              BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}"
              Padding="8,8"
              ColumnDefinitions="Auto,*,Auto">

            <Button Grid.Column="0"
                    Text="‹"
                    Clicked="OnBackClicked"
                    Style="{StaticResource IconButton}"
                    FontSize="24"
                    Margin="4,0,0,0"/>

            <Label x:Name="BookTitleLabel"
                   Grid.Column="1"
                   Text=""
                   Style="{StaticResource NavTitle}"
                   HorizontalTextAlignment="Center"
                   LineBreakMode="TailTruncation"/>

            <BoxView Grid.Column="2" WidthRequest="36"/>
        </Grid>

        <!-- ================= TOOLBAR — compact icon strip ================= -->
        <ScrollView Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalScrollBarVisibility="Never"
                    BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}">
            <HorizontalStackLayout Padding="12,4,12,8" Spacing="4">

                <Button x:Name="PrevButton" Text="‹"
                        Clicked="OnPrevClicked"
                        Style="{StaticResource IconButton}"
                        FontSize="22"
                        IsEnabled="False"/>

                <Label x:Name="PageInfoLabel"
                       Text="0 / 0"
                       Style="{StaticResource Caption}"
                       WidthRequest="56"
                       FontSize="12"
                       HorizontalTextAlignment="Center"
                       VerticalTextAlignment="Center"/>

                <Button x:Name="NextButton" Text="›"
                        Clicked="OnNextClicked"
                        Style="{StaticResource IconButton}"
                        FontSize="22"
                        IsEnabled="False"/>

                <BoxView WidthRequest="1" HeightRequest="20" 
                         Color="{AppThemeBinding Light=#E5E5EA, Dark=#38383A}"
                         VerticalOptions="Center" Margin="6,0"/>

                <Button x:Name="GridButton" Text="⊞"
                        Clicked="OnGridClicked"
                        Style="{StaticResource IconButton}"
                        FontSize="18"
                        IsEnabled="False"/>

                <Button x:Name="TeacherNotesButton" Text="✎"
                        Clicked="OnTeacherNotesClicked"
                        Style="{StaticResource Chip}"
                        IsEnabled="False"/>

                <Button x:Name="StudentAnswersButton" Text="✓"
                        Clicked="OnStudentAnswersClicked"
                        Style="{StaticResource Chip}"
                        IsEnabled="False"/>

                <Button x:Name="SideBySideButton" Text="1"
                        Clicked="OnSideBySideClicked"
                        Style="{StaticResource Chip}"
                        IsEnabled="False"/>

                <Button x:Name="ViewModeButton" Text="◉"
                        Clicked="OnViewModeClicked"
                        Style="{StaticResource Chip}"
                        IsEnabled="False"/>

                <Button x:Name="DecryptButton" Text="🔒"
                        Clicked="OnDecryptClicked"
                        Style="{StaticResource IconButton}"
                        FontSize="16"
                        IsEnabled="False"/>

                <Button x:Name="ExportPdfButton" Text="⇪"
                        Clicked="OnExportPdfClicked"
                        Style="{StaticResource IconButton}"
                        FontSize="18"
                        IsEnabled="False"/>

                <BoxView WidthRequest="1" HeightRequest="20"
                         Color="{AppThemeBinding Light=#E5E5EA, Dark=#38383A}"
                         VerticalOptions="Center" Margin="6,0"/>

                <!-- Zoom pill -->
                <Frame CornerRadius="16"
                       HasShadow="False"
                       BackgroundColor="{AppThemeBinding Light={StaticResource Elevated}, Dark={StaticResource ElevatedDark}}"
                       Padding="2,0"
                       HeightRequest="32"
                       VerticalOptions="Center">
                    <HorizontalStackLayout Spacing="0">
                        <Button x:Name="ZoomOutButton"
                                Text="−"
                                Clicked="OnZoomOutClicked"
                                BackgroundColor="Transparent"
                                TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                FontSize="16"
                                WidthRequest="32"
                                HeightRequest="32"
                                Padding="0"
                                CornerRadius="16"/>
                        <Label x:Name="ZoomLabel"
                               Text="1.0x"
                               Style="{StaticResource Caption}"
                               WidthRequest="42"
                               FontSize="12"
                               HorizontalTextAlignment="Center"
                               VerticalTextAlignment="Center"/>
                        <Button x:Name="ZoomInButton"
                                Text="+"
                                Clicked="OnZoomInClicked"
                                BackgroundColor="Transparent"
                                TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                FontSize="16"
                                WidthRequest="32"
                                HeightRequest="32"
                                Padding="0"
                                CornerRadius="16"/>
                    </HorizontalStackLayout>
                </Frame>

            </HorizontalStackLayout>
        </ScrollView>

        <!-- ================= CONTENT ================= -->
        <Grid Grid.Row="2"
              BackgroundColor="{AppThemeBinding Light={StaticResource Canvas}, Dark={StaticResource CanvasDark}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftColumn" Width="*"/>
                <ColumnDefinition x:Name="RightColumn" Width="0"/>
            </Grid.ColumnDefinitions>

            <WebView x:Name="ContentWebView" Grid.Column="0"/>
            <WebView x:Name="NextPageWebView" Grid.Column="1" IsVisible="False"/>
            <WebView x:Name="TeacherWebView" Grid.Column="1" IsVisible="False"/>
            <WebView x:Name="StudentWebView" Grid.Column="1" IsVisible="False"/>
        </Grid>

        <!-- ================= STATUS ================= -->
        <Grid Grid.Row="3"
              BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}"
              Padding="20,8">
            <Label x:Name="StatusLabel"
                   Text=""
                   Style="{StaticResource Caption}"
                   LineBreakMode="TailTruncation"/>
        </Grid>
    </Grid>
</ContentPage>
