<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BookViewer.Views.BookViewerPage"
             BackgroundColor="{AppThemeBinding Light={StaticResource Background}, Dark={StaticResource BackgroundDark}}">

    <Grid RowDefinitions="Auto,Auto,*,Auto"
          Padding="{OnPlatform iOS='0,0,0,16', Android='0', WinUI='0'}">

        <!-- ================= TOP BAR ================= -->
        <Grid Grid.Row="0"
              BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}"
              Padding="8,6"
              ColumnDefinitions="Auto,*,Auto">

            <Button Grid.Column="0"
                    x:Name="BackButton"
                    Text="‹ Back"
                    Clicked="OnBackClicked"
                    Style="{StaticResource TextButton}"
                    FontSize="17"
                    VerticalOptions="Center"/>

            <Label x:Name="BookTitleLabel"
                   Grid.Column="1"
                   Text=""
                   Style="{StaticResource TitleLabel}"
                   HorizontalTextAlignment="Center"
                   LineBreakMode="TailTruncation"/>

            <Label Grid.Column="2" Text="" WidthRequest="60"/>
        </Grid>

        <BoxView Grid.Row="0"
                 HeightRequest="0.5"
                 Color="{AppThemeBinding Light={StaticResource Separator}, Dark={StaticResource SeparatorDark}}"
                 VerticalOptions="End"/>

        <!-- ================= TOOLBAR ================= -->
        <ScrollView Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalScrollBarVisibility="Never"
                    BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}">
            <HorizontalStackLayout Padding="10,6" Spacing="6">

                <Button x:Name="PrevButton"
                        Text="‹ Prev"
                        Clicked="OnPrevClicked"
                        Style="{StaticResource TextButton}"
                        IsEnabled="False"/>

                <Label x:Name="PageInfoLabel"
                       Text="0 / 0"
                       Style="{StaticResource CaptionLabel}"
                       WidthRequest="60"
                       HorizontalTextAlignment="Center"
                       VerticalTextAlignment="Center"/>

                <Button x:Name="NextButton"
                        Text="Next ›"
                        Clicked="OnNextClicked"
                        Style="{StaticResource TextButton}"
                        IsEnabled="False"/>

                <Button x:Name="GridButton"
                        Text="Grid"
                        Clicked="OnGridClicked"
                        Style="{StaticResource TextButton}"
                        IsEnabled="False"/>

                <Button x:Name="TeacherNotesButton"
                        Text="Notes"
                        Clicked="OnTeacherNotesClicked"
                        Style="{StaticResource ToggleButton}"
                        IsEnabled="False"/>

                <Button x:Name="StudentAnswersButton"
                        Text="Answers"
                        Clicked="OnStudentAnswersClicked"
                        Style="{StaticResource ToggleButton}"
                        IsEnabled="False"/>

                <Button x:Name="DecryptButton"
                        Text="Decrypt"
                        Clicked="OnDecryptClicked"
                        Style="{StaticResource TextButton}"
                        IsEnabled="False"/>

                <Button x:Name="SideBySideButton"
                        Text="1 Page"
                        Clicked="OnSideBySideClicked"
                        Style="{StaticResource ToggleButton}"
                        IsEnabled="False"/>

                <Button x:Name="ViewModeButton"
                        Text="View"
                        Clicked="OnViewModeClicked"
                        Style="{StaticResource ToggleButton}"
                        IsEnabled="False"/>

                <Button x:Name="ExportPdfButton"
                        Text="PDF"
                        Clicked="OnExportPdfClicked"
                        Style="{StaticResource TextButton}"
                        IsEnabled="False"/>

                <!-- Segmented zoom control -->
                <Border StrokeThickness="0"
                        StrokeShape="RoundRectangle 10"
                        BackgroundColor="{AppThemeBinding Light=#EFEFF0, Dark=#2C2C2E}"
                        Padding="0"
                        HeightRequest="36"
                        VerticalOptions="Center">
                    <HorizontalStackLayout Spacing="0">
                        <Button x:Name="ZoomOutButton"
                                Text="−"
                                Clicked="OnZoomOutClicked"
                                BackgroundColor="Transparent"
                                TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                FontSize="18"
                                WidthRequest="40"
                                HeightRequest="36"
                                Padding="0"
                                CornerRadius="10"/>
                        <Label x:Name="ZoomLabel"
                               Text="1.0x"
                               Style="{StaticResource CaptionLabel}"
                               WidthRequest="48"
                               HorizontalTextAlignment="Center"
                               VerticalTextAlignment="Center"/>
                        <Button x:Name="ZoomInButton"
                                Text="+"
                                Clicked="OnZoomInClicked"
                                BackgroundColor="Transparent"
                                TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                FontSize="18"
                                WidthRequest="40"
                                HeightRequest="36"
                                Padding="0"
                                CornerRadius="10"/>
                    </HorizontalStackLayout>
                </Border>

            </HorizontalStackLayout>
        </ScrollView>

        <BoxView Grid.Row="1"
                 HeightRequest="0.5"
                 Color="{AppThemeBinding Light={StaticResource Separator}, Dark={StaticResource SeparatorDark}}"
                 VerticalOptions="End"/>

        <!-- ================= CONTENT ================= -->
        <Grid Grid.Row="2"
              BackgroundColor="{AppThemeBinding Light={StaticResource Background}, Dark={StaticResource BackgroundDark}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftColumn" Width="*"/>
                <ColumnDefinition x:Name="RightColumn" Width="0"/>
            </Grid.ColumnDefinitions>

            <WebView x:Name="ContentWebView"
                     Grid.Column="0"/>

            <WebView x:Name="NextPageWebView"
                     Grid.Column="1"
                     IsVisible="False"/>

            <WebView x:Name="TeacherWebView"
                     Grid.Column="1"
                     IsVisible="False"/>

            <WebView x:Name="StudentWebView"
                     Grid.Column="1"
                     IsVisible="False"/>
        </Grid>

        <!-- ================= STATUS BAR ================= -->
        <Grid Grid.Row="3"
              BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}"
              Padding="16,6">
            <Label x:Name="StatusLabel"
                   Text=""
                   Style="{StaticResource CaptionLabel}"
                   LineBreakMode="TailTruncation"/>
        </Grid>
    </Grid>
</ContentPage>
