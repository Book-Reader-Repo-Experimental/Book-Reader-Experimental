<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BookViewer.Views.UnitPage"
             BackgroundColor="{AppThemeBinding Light={StaticResource Background}, Dark={StaticResource BackgroundDark}}">

    <Grid RowDefinitions="Auto,Auto,Auto,*">

        <!-- ================= TOP BAR ================= -->
        <Grid Grid.Row="0"
              BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}"
              Padding="8,6"
              ColumnDefinitions="Auto,*">

            <Button Grid.Column="0"
                    Text="‹ Back"
                    Clicked="OnBackClicked"
                    Style="{StaticResource TextButton}"
                    FontSize="17"
                    VerticalOptions="Center"/>

            <Label Grid.Column="1"
                   x:Name="UnitTitleLabel"
                   Text=""
                   Style="{StaticResource TitleLabel}"
                   VerticalOptions="Center"
                   LineBreakMode="TailTruncation"/>
        </Grid>

        <BoxView Grid.Row="0"
                 HeightRequest="0.5"
                 Color="{AppThemeBinding Light={StaticResource Separator}, Dark={StaticResource SeparatorDark}}"
                 VerticalOptions="End"/>

        <!-- ================= BANNER ================= -->
        <Image x:Name="UnitBannerImage"
               Grid.Row="1"
               Aspect="AspectFill"
               HeightRequest="160"
               HorizontalOptions="Fill"
               IsVisible="False"/>

        <!-- ================= SEGMENTED TABS ================= -->
        <Grid Grid.Row="2"
              BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}"
              Padding="16,8">

            <Border StrokeThickness="0"
                    StrokeShape="RoundRectangle 10"
                    BackgroundColor="{AppThemeBinding Light=#EFEFF0, Dark=#2C2C2E}"
                    HeightRequest="36"
                    HorizontalOptions="Fill">
                <Grid ColumnDefinitions="*,*">
                    <Button x:Name="ContentsTab"
                            Grid.Column="0"
                            Text="Contents"
                            Clicked="OnContentsTabClicked"
                            BackgroundColor="Transparent"
                            TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                            FontSize="14"
                            FontAttributes="Bold"
                            Padding="0"
                            CornerRadius="8"
                            Margin="2"/>
                    <Button x:Name="ResourcesTab"
                            Grid.Column="1"
                            Text="Resources"
                            Clicked="OnResourcesTabClicked"
                            BackgroundColor="Transparent"
                            TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                            FontSize="14"
                            Padding="0"
                            CornerRadius="8"
                            Margin="2"/>
                </Grid>
            </Border>
        </Grid>

        <!-- ================= CONTENT ================= -->
        <Grid Grid.Row="3">

            <!-- Contents view -->
            <ScrollView x:Name="ContentsView" IsVisible="True">
                <CollectionView x:Name="SectionsCollection"
                                SelectionMode="None">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="20,16"
                                  BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}"
                                  ColumnDefinitions="*,Auto">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnSectionTapped"/>
                                </Grid.GestureRecognizers>

                                <Label Grid.Column="0"
                                       Text="{Binding Name}"
                                       Style="{StaticResource BodyLabel}"
                                       FontSize="15"
                                       VerticalTextAlignment="Center"/>

                                <Label Grid.Column="1"
                                       Text="{Binding PageStart}"
                                       Style="{StaticResource CaptionLabel}"
                                       FontSize="14"
                                       VerticalTextAlignment="Center"/>

                                <BoxView Grid.ColumnSpan="2"
                                         HeightRequest="0.5"
                                         Color="{AppThemeBinding Light={StaticResource Separator}, Dark={StaticResource SeparatorDark}}"
                                         VerticalOptions="End"
                                         Margin="-20,0,0,0"/>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </ScrollView>

            <!-- Resources view -->
            <ScrollView x:Name="ResourcesView" IsVisible="False">
                <CollectionView x:Name="ResourcesCollection"
                                SelectionMode="None">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="20,14"
                                  BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}"
                                  ColumnDefinitions="40,*,Auto">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnResourceTapped"/>
                                </Grid.GestureRecognizers>

                                <Label Grid.Column="0"
                                       Text="{Binding TypeIcon}"
                                       FontSize="16"
                                       TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                                       VerticalTextAlignment="Center"/>

                                <Label Grid.Column="1"
                                       Text="{Binding Description}"
                                       Style="{StaticResource BodyLabel}"
                                       FontSize="14"
                                       VerticalTextAlignment="Center"
                                       Margin="4,0,0,0"/>

                                <Label Grid.Column="2"
                                       Text="{Binding PageNumber}"
                                       Style="{StaticResource CaptionLabel}"
                                       FontSize="13"
                                       VerticalTextAlignment="Center"/>

                                <BoxView Grid.ColumnSpan="3"
                                         HeightRequest="0.5"
                                         Color="{AppThemeBinding Light={StaticResource Separator}, Dark={StaticResource SeparatorDark}}"
                                         VerticalOptions="End"
                                         Margin="-20,0,0,0"/>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </ScrollView>
        </Grid>
    </Grid>
</ContentPage>
