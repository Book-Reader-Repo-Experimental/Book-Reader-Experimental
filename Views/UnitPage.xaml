<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BookViewer.Views.UnitPage"
             BackgroundColor="{AppThemeBinding Light={StaticResource Canvas}, Dark={StaticResource CanvasDark}}">

    <Grid RowDefinitions="Auto,Auto,Auto,*">

        <!-- ================= NAV BAR ================= -->
        <Grid Grid.Row="0"
              BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}"
              Padding="8,8"
              ColumnDefinitions="Auto,*,Auto">

            <Button Grid.Column="0"
                    Text="‹"
                    Clicked="OnBackClicked"
                    Style="{StaticResource IconButton}"
                    FontSize="24"
                    Margin="4,0,0,0"/>

            <Label Grid.Column="1"
                   x:Name="UnitTitleLabel"
                   Text=""
                   Style="{StaticResource NavTitle}"
                   HorizontalTextAlignment="Center"
                   LineBreakMode="TailTruncation"/>

            <BoxView Grid.Column="2" WidthRequest="36"/>
        </Grid>

        <!-- ================= BANNER ================= -->
        <Image x:Name="UnitBannerImage"
               Grid.Row="1"
               Aspect="AspectFill"
               HeightRequest="180"
               HorizontalOptions="Fill"
               IsVisible="False"/>

        <!-- ================= SEGMENTED CONTROL ================= -->
        <Grid Grid.Row="2"
              BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}"
              Padding="16,8">

            <Frame CornerRadius="9"
                   HasShadow="False"
                   BackgroundColor="{AppThemeBinding Light={StaticResource Elevated}, Dark={StaticResource ElevatedDark}}"
                   Padding="2"
                   HeightRequest="36">
                <Grid ColumnDefinitions="*,*">
                    <Button x:Name="ContentsTab"
                            Grid.Column="0"
                            Text="Contents"
                            Clicked="OnContentsTabClicked"
                            BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark=#48484A}"
                            TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                            FontSize="13"
                            FontAttributes="Bold"
                            Padding="0"
                            CornerRadius="7"/>
                    <Button x:Name="ResourcesTab"
                            Grid.Column="1"
                            Text="Resources"
                            Clicked="OnResourcesTabClicked"
                            BackgroundColor="Transparent"
                            TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                            FontSize="13"
                            Padding="0"
                            CornerRadius="7"/>
                </Grid>
            </Frame>
        </Grid>

        <!-- ================= CONTENT ================= -->
        <Grid Grid.Row="3">

            <ScrollView x:Name="ContentsView" IsVisible="True">
                <CollectionView x:Name="SectionsCollection"
                                SelectionMode="None">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="20,16"
                                  BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}"
                                  ColumnDefinitions="*,Auto,12">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnSectionTapped"/>
                                </Grid.GestureRecognizers>

                                <Label Grid.Column="0"
                                       Text="{Binding Name}"
                                       Style="{StaticResource Body}"
                                       FontSize="15"
                                       VerticalTextAlignment="Center"/>

                                <Label Grid.Column="1"
                                       Text="{Binding PageStart}"
                                       Style="{StaticResource Caption}"
                                       FontSize="14"
                                       VerticalTextAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </ScrollView>

            <ScrollView x:Name="ResourcesView" IsVisible="False">
                <CollectionView x:Name="ResourcesCollection"
                                SelectionMode="None">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="20,14"
                                  BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}"
                                  ColumnDefinitions="36,*,Auto">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnResourceTapped"/>
                                </Grid.GestureRecognizers>

                                <Label Grid.Column="0"
                                       Text="{Binding TypeIcon}"
                                       FontSize="16"
                                       TextColor="{AppThemeBinding Light={StaticResource Accent}, Dark={StaticResource AccentDark}}"
                                       VerticalTextAlignment="Center"/>

                                <Label Grid.Column="1"
                                       Text="{Binding Description}"
                                       Style="{StaticResource Body}"
                                       FontSize="15"
                                       VerticalTextAlignment="Center"/>

                                <Label Grid.Column="2"
                                       Text="{Binding PageNumber}"
                                       Style="{StaticResource Caption}"
                                       FontSize="13"
                                       VerticalTextAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </ScrollView>
        </Grid>
    </Grid>
</ContentPage>
