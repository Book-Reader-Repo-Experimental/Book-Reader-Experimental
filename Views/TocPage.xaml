<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BookViewer.Views.TocPage"
             BackgroundColor="{AppThemeBinding Light={StaticResource Canvas}, Dark={StaticResource CanvasDark}}">

    <Grid RowDefinitions="Auto,*">

        <!-- ================= NAV BAR ================= -->
        <Grid Grid.Row="0"
              BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}"
              Padding="8,8"
              ColumnDefinitions="Auto,*,Auto">

            <Button x:Name="BackButton"
                    Grid.Column="0"
                    Text="‹ Back"
                    Clicked="OnBackTapped"
                    Style="{StaticResource TextButton}"
                    FontSize="15"
                    Padding="6,0"
                    MinimumHeightRequest="40"
                    MaximumWidthRequest="{OnIdiom Phone=180, Tablet=280, Default=220}"
                    LineBreakMode="TailTruncation"
                    HorizontalOptions="Start"
                    VerticalOptions="Center"/>

            <Label x:Name="TitleLabel"
                   Grid.Column="1"
                   Text="Contents"
                   Style="{StaticResource NavTitle}"
                   HorizontalTextAlignment="Center"/>

            <BoxView Grid.Column="2" WidthRequest="40"/>
        </Grid>

        <!-- ================= CONTENT ================= -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="0,8,0,24">

                <Label x:Name="BookTitleLabel"
                       Text=""
                       Style="{StaticResource SectionHeader}"/>

                <CollectionView x:Name="UnitsCollection"
                                SelectionMode="None"
                                Margin="0">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="20,16"
                                  BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}"
                                  ColumnDefinitions="*,Auto,12">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnUnitTapped"/>
                                </Grid.GestureRecognizers>

                                <Label Grid.Column="0"
                                       Text="{Binding Title}"
                                       Style="{StaticResource Body}"
                                       FontSize="16"
                                       VerticalTextAlignment="Center"/>

                                <Label Grid.Column="1"
                                       Text="›"
                                       FontSize="18"
                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                       VerticalTextAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
