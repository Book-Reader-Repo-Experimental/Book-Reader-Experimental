<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BookViewer.Views.TocPage"
             BackgroundColor="{AppThemeBinding Light={StaticResource Background}, Dark={StaticResource BackgroundDark}}">

    <Grid RowDefinitions="Auto,*">

        <!-- ================= TOP BAR ================= -->
        <Grid Grid.Row="0"
              BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}"
              Padding="8,6"
              ColumnDefinitions="Auto,*,Auto">

            <Button Grid.Column="0"
                    Text="‹ Back"
                    Clicked="OnBackTapped"
                    Style="{StaticResource TextButton}"
                    FontSize="17"
                    VerticalOptions="Center"/>

            <Label x:Name="TitleLabel"
                   Grid.Column="1"
                   Text="Contents"
                   Style="{StaticResource TitleLabel}"
                   HorizontalTextAlignment="Center"/>

            <Label Grid.Column="2" Text="" WidthRequest="60"/>
        </Grid>

        <BoxView Grid.Row="0"
                 HeightRequest="0.5"
                 Color="{AppThemeBinding Light={StaticResource Separator}, Dark={StaticResource SeparatorDark}}"
                 VerticalOptions="End"/>

        <!-- ================= CONTENT ================= -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout>

                <Label x:Name="BookTitleLabel"
                       Text=""
                       Style="{StaticResource CaptionLabel}"
                       Padding="20,14"
                       BackgroundColor="{AppThemeBinding Light={StaticResource Background}, Dark={StaticResource BackgroundDark}}"/>

                <CollectionView x:Name="UnitsCollection"
                                SelectionMode="None">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="20,18"
                                  BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}"
                                  ColumnDefinitions="*,Auto">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnUnitTapped"/>
                                </Grid.GestureRecognizers>

                                <Label Grid.Column="0"
                                       Text="{Binding Title}"
                                       Style="{StaticResource BodyLabel}"
                                       FontSize="16"
                                       VerticalTextAlignment="Center"/>

                                <Label Grid.Column="1"
                                       Text="›"
                                       Style="{StaticResource CaptionLabel}"
                                       FontSize="18"
                                       VerticalTextAlignment="Center"
                                       Margin="8,0,0,0"/>

                                <BoxView Grid.ColumnSpan="2"
                                         HeightRequest="0.5"
                                         Color="{AppThemeBinding Light={StaticResource Separator}, Dark={StaticResource SeparatorDark}}"
                                         VerticalOptions="End"
                                         Margin="-20,0,0,0"/>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
