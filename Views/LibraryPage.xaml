<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BookViewer.Views.LibraryPage"
             BackgroundColor="{AppThemeBinding Light={StaticResource Background}, Dark={StaticResource BackgroundDark}}">

    <Grid RowDefinitions="Auto,Auto,*,Auto"
          Padding="{OnPlatform iOS='0,0,0,16', Android='0', WinUI='0'}">

        <!-- ================= TOP BAR ================= -->
        <Grid Grid.Row="0"
              BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}"
              Padding="16,10"
              ColumnDefinitions="*,Auto,Auto,Auto"
              ColumnSpacing="4">

            <Label Grid.Column="0"
                   Text="Library"
                   Style="{StaticResource LargeTitleLabel}"
                   VerticalOptions="Center"/>

            <Button Grid.Column="1"
                    Text="↻"
                    Clicked="OnRefreshClicked"
                    Style="{StaticResource IconButton}"
                    FontSize="20"
                    VerticalOptions="Center"/>

            <Button Grid.Column="2"
                    Text="⇩"
                    Clicked="OnBatchDownloadClicked"
                    Style="{StaticResource IconButton}"
                    FontSize="20"
                    VerticalOptions="Center"/>

            <Button Grid.Column="3"
                    Text="＋"
                    Clicked="OnDownloadClicked"
                    Style="{StaticResource IconButton}"
                    FontSize="22"
                    FontAttributes="Bold"
                    VerticalOptions="Center"/>
        </Grid>

        <BoxView Grid.Row="0"
                 HeightRequest="0.5"
                 Color="{AppThemeBinding Light={StaticResource Separator}, Dark={StaticResource SeparatorDark}}"
                 VerticalOptions="End"/>

        <!-- ================= SEARCH BAR ================= -->
        <Border Grid.Row="1"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 10"
                BackgroundColor="{AppThemeBinding Light=#EFEFF0, Dark=#1C1C1E}"
                Margin="16,8"
                Padding="10,0">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                <Label Grid.Column="0"
                       Text="🔍"
                       FontSize="15"
                       VerticalOptions="Center"
                       Opacity="0.6"/>
                <Entry x:Name="SearchEntry"
                       Grid.Column="1"
                       Placeholder="Search"
                       BackgroundColor="Transparent"
                       FontSize="16"
                       TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                       PlaceholderColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                       TextChanged="OnSearchTextChanged"/>
                <Button Grid.Column="2"
                        Text="✕"
                        Clicked="OnClearSearchClicked"
                        Style="{StaticResource IconButton}"
                        FontSize="14"
                        WidthRequest="32"
                        HeightRequest="32"
                        MinimumWidthRequest="32"
                        MinimumHeightRequest="32"
                        Opacity="0.7"/>
            </Grid>
        </Border>

        <!-- ================= BOOK GRID ================= -->
        <ScrollView Grid.Row="2">
            <CollectionView x:Name="BooksCollection"
                            Margin="16,4,16,16"
                            SelectionMode="None">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical"
                                     Span="{OnIdiom Phone=2, Tablet=4, Desktop=6}"
                                     HorizontalItemSpacing="16"
                                     VerticalItemSpacing="20"/>
                </CollectionView.ItemsLayout>

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <VerticalStackLayout Spacing="8" Padding="4">
                            <VerticalStackLayout.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnBookTapped"/>
                            </VerticalStackLayout.GestureRecognizers>

                            <Border Padding="0"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 8"
                                    BackgroundColor="{AppThemeBinding Light=#EFEFF0, Dark=#2C2C2E}"
                                    HorizontalOptions="Fill"
                                    HeightRequest="200"
                                    IsClippedToBounds="True"
                                    InputTransparent="True">
                                <Border.Shadow>
                                    <Shadow Brush="Black" Opacity="0.08" Radius="6" Offset="0,2"/>
                                </Border.Shadow>
                                <Image Source="{Binding CoverImageSource}"
                                       Aspect="AspectFill"
                                       InputTransparent="True"/>
                            </Border>

                            <Label Text="{Binding DisplayName}"
                                   Style="{StaticResource BodyLabel}"
                                   FontSize="13"
                                   HorizontalTextAlignment="Center"
                                   LineBreakMode="TailTruncation"
                                   MaxLines="2"
                                   InputTransparent="True"/>

                            <Label Text="{Binding BookIdLabel}"
                                   Style="{StaticResource CaptionLabel}"
                                   FontSize="11"
                                   HorizontalTextAlignment="Center"
                                   InputTransparent="True"/>
                        </VerticalStackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </ScrollView>

        <!-- ================= STATUS BAR ================= -->
        <Grid Grid.Row="3"
              BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}"
              Padding="16,6">
            <Label x:Name="StatusLabel"
                   Text=""
                   Style="{StaticResource CaptionLabel}"
                   LineBreakMode="TailTruncation"/>
        </Grid>
    </Grid>
</ContentPage>
