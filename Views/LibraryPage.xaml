<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BookViewer.Views.LibraryPage"
             BackgroundColor="{AppThemeBinding Light={StaticResource Canvas}, Dark={StaticResource CanvasDark}}">

    <Grid RowDefinitions="Auto,Auto,*,Auto">

        <!-- ================= TOP BAR ================= -->
        <!-- Translucent material: solid on Android, tinted on iOS -->
        <Grid Grid.Row="0"
              BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}"
              Padding="20,12"
              ColumnDefinitions="*,Auto,Auto,Auto"
              ColumnSpacing="2">

            <Label Grid.Column="0"
                   Text="Library"
                   Style="{StaticResource LargeTitle}"
                   VerticalOptions="Center"/>

            <Button Grid.Column="1"
                    Text="↻"
                    Clicked="OnRefreshClicked"
                    Style="{StaticResource IconButton}"/>

            <Button Grid.Column="2"
                    Text="⇩"
                    Clicked="OnBatchDownloadClicked"
                    Style="{StaticResource IconButton}"/>

            <Button Grid.Column="3"
                    Text="＋"
                    Clicked="OnDownloadClicked"
                    Style="{StaticResource IconButton}"
                    FontAttributes="Bold"/>
        </Grid>

        <!-- ================= SEARCH ================= -->
        <Grid Grid.Row="1"
              BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}"
              Padding="20,4,20,12"
              ColumnDefinitions="Auto,*,Auto"
              ColumnSpacing="6">

            <Label Grid.Column="0"
                   Text="🔍"
                   FontSize="15"
                   VerticalOptions="Center"
                   Opacity="0.5"/>

            <Entry x:Name="SearchEntry"
                   Grid.Column="1"
                   Placeholder="Search"
                   BackgroundColor="Transparent"
                   FontSize="16"
                   TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                   PlaceholderColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                   TextChanged="OnSearchTextChanged"/>

            <Button Grid.Column="2"
                    Text="✕"
                    Clicked="OnClearSearchClicked"
                    Style="{StaticResource IconButton}"
                    FontSize="14"
                    Opacity="0.5"
                    WidthRequest="28"
                    HeightRequest="28"
                    MinimumWidthRequest="28"
                    MinimumHeightRequest="28"/>
        </Grid>

        <!-- ================= BOOK GRID ================= -->
        <CollectionView x:Name="BooksCollection"
                        Grid.Row="2"
                        Margin="12,8,12,12"
                        SelectionMode="None">
            <CollectionView.ItemsLayout>
                <GridItemsLayout Orientation="Vertical"
                                 Span="{OnIdiom Phone=2, Tablet=4, Default=5}"
                                 HorizontalItemSpacing="14"
                                 VerticalItemSpacing="18"/>
            </CollectionView.ItemsLayout>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <VerticalStackLayout Spacing="6" Padding="4">
                        <VerticalStackLayout.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnBookTapped"/>
                        </VerticalStackLayout.GestureRecognizers>

                        <!-- No frame — just the image with rounded corners baked into the border-less background -->
                        <Frame Padding="0"
                               CornerRadius="6"
                               HasShadow="False"
                               BackgroundColor="{AppThemeBinding Light={StaticResource Elevated}, Dark={StaticResource ElevatedDark}}"
                               HeightRequest="180"
                               IsClippedToBounds="True"
                               InputTransparent="True">
                            <Image Source="{Binding CoverImageSource}"
                                   Aspect="AspectFill"
                                   InputTransparent="True"/>
                        </Frame>

                        <Label Text="{Binding DisplayName}"
                               FontSize="13"
                               FontAttributes="None"
                               TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                               HorizontalTextAlignment="Center"
                               LineBreakMode="TailTruncation"
                               MaxLines="2"
                               InputTransparent="True"/>

                        <Label Text="{Binding BookIdLabel}"
                               Style="{StaticResource Caption}"
                               FontSize="11"
                               HorizontalTextAlignment="Center"
                               InputTransparent="True"/>
                    </VerticalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- ================= STATUS ================= -->
        <Grid Grid.Row="3"
              BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}"
              Padding="20,8">
            <Label x:Name="StatusLabel"
                   Text=""
                   Style="{StaticResource Caption}"
                   LineBreakMode="TailTruncation"/>
        </Grid>
    </Grid>
</ContentPage>
