<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BookViewer.Views.PageGridView"
             BackgroundColor="{AppThemeBinding Light={StaticResource Canvas}, Dark={StaticResource CanvasDark}}">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- ================= NAV BAR ================= -->
        <Grid Grid.Row="0"
              BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}"
              Padding="8,8"
              ColumnDefinitions="Auto,*,Auto">

            <Button Grid.Column="0"
                    Text="‹"
                    Clicked="OnCloseClicked"
                    Style="{StaticResource IconButton}"
                    FontSize="24"
                    Margin="4,0,0,0"/>

            <Label Grid.Column="1"
                   Text="Pages"
                   Style="{StaticResource NavTitle}"
                   HorizontalTextAlignment="Center"/>

            <BoxView Grid.Column="2" WidthRequest="36"/>
        </Grid>

        <!-- ================= PAGE GRID ================= -->
        <CollectionView x:Name="PagesCollection"
                        Grid.Row="1"
                        Margin="10"
                        SelectionMode="None">
            <CollectionView.ItemsLayout>
                <GridItemsLayout Orientation="Vertical"
                                 Span="{OnIdiom Phone=2, Tablet=4, Default=5}"
                                 HorizontalItemSpacing="10"
                                 VerticalItemSpacing="10"/>
            </CollectionView.ItemsLayout>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <VerticalStackLayout Spacing="4">
                        <VerticalStackLayout.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnPageTapped"/>
                        </VerticalStackLayout.GestureRecognizers>

                        <Frame Padding="0"
                               CornerRadius="6"
                               HasShadow="False"
                               BackgroundColor="{AppThemeBinding Light={StaticResource Elevated}, Dark={StaticResource ElevatedDark}}"
                               HeightRequest="270"
                               IsClippedToBounds="True">
                            <Image Source="{Binding ThumbnailSource}"
                                   Aspect="AspectFill"/>
                        </Frame>

                        <Label Text="{Binding PageNumber}"
                               Style="{StaticResource Caption}"
                               FontSize="11"
                               HorizontalTextAlignment="Center"/>
                    </VerticalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- ================= STATUS ================= -->
        <Grid Grid.Row="2"
              BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}"
              Padding="20,8">
            <Label x:Name="StatusText"
                   Text=""
                   Style="{StaticResource Caption}"
                   LineBreakMode="TailTruncation"/>
        </Grid>
    </Grid>
</ContentPage>
