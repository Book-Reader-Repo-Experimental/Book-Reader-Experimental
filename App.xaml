<?xml version="1.0" encoding="utf-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BookViewer.App">
    <Application.Resources>
        <ResourceDictionary>

            <!-- ============ COLORS ============ -->
            <Color x:Key="Accent">#0A84FF</Color>
            <Color x:Key="AccentDark">#409CFF</Color>

            <Color x:Key="Surface">#FFFFFF</Color>
            <Color x:Key="SurfaceDark">#1C1C1E</Color>

            <Color x:Key="Elevated">#F7F7F9</Color>
            <Color x:Key="ElevatedDark">#2C2C2E</Color>

            <Color x:Key="Canvas">#F2F2F7</Color>
            <Color x:Key="CanvasDark">#000000</Color>

            <Color x:Key="TextPrimary">#000000</Color>
            <Color x:Key="TextPrimaryDark">#FFFFFF</Color>

            <Color x:Key="TextSecondary">#8E8E93</Color>
            <Color x:Key="TextSecondaryDark">#98989D</Color>

            <Color x:Key="Success">#34C759</Color>
            <Color x:Key="Danger">#FF453A</Color>

            <!-- ============ TYPOGRAPHY ============ -->
            <!-- iOS Large Title -->
            <Style x:Key="LargeTitle" TargetType="Label">
                <Setter Property="FontSize" Value="30"/>
                <Setter Property="FontAttributes" Value="Bold"/>
                <Setter Property="TextColor"
                        Value="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"/>
            </Style>

            <!-- Navigation title -->
            <Style x:Key="NavTitle" TargetType="Label">
                <Setter Property="FontSize" Value="17"/>
                <Setter Property="FontAttributes" Value="Bold"/>
                <Setter Property="TextColor"
                        Value="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"/>
                <Setter Property="VerticalTextAlignment" Value="Center"/>
            </Style>

            <!-- Body -->
            <Style x:Key="Body" TargetType="Label">
                <Setter Property="FontSize" Value="15"/>
                <Setter Property="TextColor"
                        Value="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"/>
            </Style>

            <!-- Caption / metadata -->
            <Style x:Key="Caption" TargetType="Label">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="TextColor"
                        Value="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"/>
            </Style>

            <!-- Section header (uppercase, iOS grouped list style) -->
            <Style x:Key="SectionHeader" TargetType="Label">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="FontAttributes" Value="Bold"/>
                <Setter Property="TextColor"
                        Value="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"/>
                <Setter Property="Margin" Value="20,20,20,6"/>
            </Style>

            <!-- ============ BUTTONS ============ -->

            <!-- Text button (accent tint, no bg) -->
            <Style x:Key="TextButton" TargetType="Button">
                <Setter Property="BackgroundColor" Value="Transparent"/>
                <Setter Property="TextColor"
                        Value="{AppThemeBinding Light={StaticResource Accent}, Dark={StaticResource AccentDark}}"/>
                <Setter Property="FontSize" Value="15"/>
                <Setter Property="Padding" Value="10,6"/>
                <Setter Property="MinimumHeightRequest" Value="36"/>
                <Setter Property="MinimumWidthRequest" Value="36"/>
                <Setter Property="CornerRadius" Value="8"/>
            </Style>

            <!-- Icon button (compact, tinted) -->
            <Style x:Key="IconButton" TargetType="Button">
                <Setter Property="BackgroundColor" Value="Transparent"/>
                <Setter Property="TextColor"
                        Value="{AppThemeBinding Light={StaticResource Accent}, Dark={StaticResource AccentDark}}"/>
                <Setter Property="FontSize" Value="18"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="MinimumHeightRequest" Value="36"/>
                <Setter Property="MinimumWidthRequest" Value="36"/>
                <Setter Property="WidthRequest" Value="36"/>
                <Setter Property="HeightRequest" Value="36"/>
                <Setter Property="CornerRadius" Value="8"/>
            </Style>

            <!-- Pill chip (segmented control / filter chip) -->
            <Style x:Key="Chip" TargetType="Button">
                <Setter Property="BackgroundColor"
                        Value="{AppThemeBinding Light={StaticResource Elevated}, Dark={StaticResource ElevatedDark}}"/>
                <Setter Property="TextColor"
                        Value="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Padding" Value="14,6"/>
                <Setter Property="MinimumHeightRequest" Value="32"/>
                <Setter Property="CornerRadius" Value="16"/>
            </Style>

            <!-- Primary filled (rare — only for main CTA) -->
            <Style x:Key="PrimaryButton" TargetType="Button">
                <Setter Property="BackgroundColor"
                        Value="{AppThemeBinding Light={StaticResource Accent}, Dark={StaticResource AccentDark}}"/>
                <Setter Property="TextColor" Value="White"/>
                <Setter Property="FontSize" Value="15"/>
                <Setter Property="FontAttributes" Value="Bold"/>
                <Setter Property="Padding" Value="20,12"/>
                <Setter Property="MinimumHeightRequest" Value="44"/>
                <Setter Property="CornerRadius" Value="22"/>
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
